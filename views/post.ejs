<%- include('partials/header', { title: post.title }) %>

<article class="post-detail">
  <header class="post-header">
    <h1><%= post.title %></h1>
    <div class="post-meta">
      <time>更新于 <%= post.updated_at %></time>
    </div>
  </header>
  <div class="post-content markdown-body">
    <%- contentHtml %>
  </div>
</article>

<div class="post-nav">
  <a href="/">&larr; 返回首页</a>
</div>

<%- include('partials/footer') %>
